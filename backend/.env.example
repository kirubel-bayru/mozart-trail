PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mozart

# Neon / cloud Postgres usually need SSL (auto-detected for neon.tech URLs)
# DATABASE_SSL=true

# Generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production

# Production: comma-separated frontend origins, e.g.
# CORS_ORIGIN=https://mozart-trail.pages.dev,https://preview.pages.dev

# Future: base URL of your music API (frontend sets USE_MUSIC_API=true to use /api/music/:id)
# MUSIC_API_URL=https://your-music-api.example.com
